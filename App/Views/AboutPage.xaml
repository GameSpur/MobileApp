<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:viewmodels="clr-namespace:GamHubApp.ViewModels"  
             xmlns:models="clr-namespace:GamHubApp.Models"  
             x:DataType="viewmodels:AboutViewModel"
             x:Class="GamHubApp.Views.AboutPage"
             x:Name="thy"
             BackgroundColor="{StaticResource BackgroundColor}">
    <Shell.TitleView>
        <Grid>
            
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="{OnPlatform Android='1.9*', 
                                                     iOS='2*'}"/>

            </Grid.ColumnDefinitions>

            <Label Text="About"
                   Grid.Column="1"
                   FontSize="30"
                   VerticalOptions="Center"
                   TextColor="{StaticResource FontColor}"
                   FontFamily="P-Bold"
                   Margin="{OnPlatform Android='-30,0,40,5', iOS='30,0,40,5'}"/>
        </Grid>

    </Shell.TitleView>
    <ContentPage.Resources>
        <!-- Style of the title -->
        <Style x:Key="TitleStyle"
               TargetType="Label">
            <Setter Property="HorizontalOptions" Value="Center" />
            <Setter Property="Margin" Value="0,20,0,20" />
            <Setter Property="FontFamily" Value="P-Bold" />
            <Setter Property="FontSize" Value="23" />
            <Setter Property="TextColor" Value="{StaticResource FontColor}" />
        </Style>
        
        <!-- Separator -->
        <Style x:Key="SeparatorStyle" 
               TargetType="BoxView">
            <Setter Property="BackgroundColor" Value="{StaticResource FontColor}" />
            <Setter Property="Margin" Value="20,0" />
            <Setter Property="HorizontalOptions" Value="Fill" />
            <Setter Property="HeightRequest" Value="1" />
            <Setter Property="Opacity" Value="0.1" />
        </Style>
        
        <!-- Paragraph -->
        <Style x:Key="ParagraphStyle"
               TargetType="Label">
            <Setter Property="HorizontalOptions" Value="Center"/>
            <Setter Property="HorizontalTextAlignment" Value="Center"/>
            <Setter Property="WidthRequest" Value="350" />
            <Setter Property="FontFamily" Value="P-Regular" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="TextColor" Value="{StaticResource FontColor}" />
            <Setter Property="Margin" Value="0,20" />
        </Style>
    </ContentPage.Resources>
    <ContentPage.Content>

        <ScrollView>
            <Grid>
            <Grid.RowDefinitions>
                <!-- Image -->
                <RowDefinition Height="100" />
                <!-- Repo link -->
                <RowDefinition Height="auto" />
                <!-- Description -->
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <!-- Business model -->
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <!-- Message for the half baked playstore reviewers -->
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="100"/>
                <!-- Creator -->
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <!-- Partners -->
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <!-- footer -->
                <RowDefinition Height="50"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            
            <!-- Image -->
                <Border StrokeShape="RoundRectangle 15"
                        BackgroundColor="{StaticResource Alternate}"
                        VerticalOptions="Center"
                        HorizontalOptions="Center"
                        Margin="5"
                        Grid.Row="0">
                    <Image Source="ares.png"
                           Aspect="AspectFit" 
                           />
                    
                </Border>
                <StackLayout Grid.Row="1"
                             Orientation="Horizontal"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"
                             Spacing="10">
                    <Border StrokeShape="RoundRectangle 12"
                           Padding="7"
                           BackgroundColor="#0d1017"
                           x:Name="GithubBtn">
                        <Border.Behaviors>
                            <mct:TouchBehavior 
                                Command="{Binding ViewGithub}"
                                BindingContext="{Binding Path=BindingContext, 
                                                 Source={x:Reference GithubBtn},
                                                 x:DataType=Border}"/>
                        </Border.Behaviors>
                        <StackLayout Orientation="Horizontal"
                                     Spacing="5">
                            <!-- Github icon -->
                            <Label Text="&#xf09b;"
                                   FontSize="20"
                                   FontFamily="FaBrand"
                                   TextColor="#fafafa"
                                   VerticalOptions="Center" />
                            <Label Text="View on Github"
                                   FontSize="12"
                                   FontFamily="P-SemiBold"
                                   TextColor="#fafafa"
                                   VerticalOptions="Center" />
                        </StackLayout>
                    </Border>
                    <Border StrokeShape="RoundRectangle 12"
                            Padding="7"
                            BackgroundColor="#e8e9eb"
                            x:Name="twitterBtn">
                        <Border.Behaviors>
                            <mct:TouchBehavior 
                                            Command="{Binding ViewTwitter}"
                                            BindingContext="{Binding Path=BindingContext, 
                                                                     Source={x:Reference twitterBtn},
                                                                     x:DataType=Border}"
                                            CommandParameter="GameSpur_App"
                                            />
                        </Border.Behaviors>
                        <StackLayout Orientation="Horizontal"
                                     Spacing="5">
                            <!-- Twitter icon -->
                            <Label Text="&#xe61a;"
                                   FontSize="20"
                                   FontFamily="FaBrand"
                                   TextColor="#000000"
                                   VerticalOptions="Center" />
                            <Label Text="Follow us on X"
                                   FontSize="12"
                                   FontFamily="P-SemiBold"
                                   TextColor="#000000"
                                   VerticalOptions="Center" />
                        </StackLayout>
                    </Border>

                </StackLayout>

            <!-- Description -->
            <Label Text="About Us"
                   Grid.Row="2"
                   Style="{StaticResource TitleStyle}" />
            <BoxView Grid.Row="3"
                     Style="{StaticResource SeparatorStyle}"/>
                <Label Text="We are a couple who built GameSpur to keep fellow gamers like us up to date on the latest gaming news and deals in one ad-free app.

GameSpur is our open-source passion project. We always welcome feedback and contributions from our community as we continue to grow. "
                   Grid.Row="4"
                   Style="{StaticResource ParagraphStyle}"/>
            
            <!-- Profit -->
                <Label Text="How We Make Money"
                   Grid.Row="5"
                   Style="{StaticResource TitleStyle}" />
            <BoxView Grid.Row="6"
                     Style="{StaticResource SeparatorStyle}"/>
                <Label Text="GameSpur is completely ad-free, and we want to keep it that way.

We partner with a handful of gaming retailers through affiliate programmes. We may earn a small commission when you purchase a game or bundle through My Deals at no extra cost to you.
These commissions help us to maintain and improve our app while letting you enjoy a cool new game and pitch in to support us, which we really appreciate!"
                   Grid.Row="7"
                   Style="{StaticResource ParagraphStyle}"/>
            
            <!-- reviewer message -->
            <Label Text="Contact us"
                   Grid.Row="8"
                   Style="{StaticResource TitleStyle}" />
                <BoxView Grid.Row="9"
                     Style="{StaticResource SeparatorStyle}"/>
                <Grid Grid.Row="10"
                      HorizontalOptions="Center"
                      RowDefinitions="*,*">

                    <Button Text="Support: support@gamespur.games"
                            Grid.Row="0"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            CornerRadius="15"
                            BackgroundColor="{StaticResource LightDark}"
                            TextColor="{StaticResource FontColor}"
                            Padding="10,0"
                            HeightRequest="30"
                            FontFamily="P-Bold"
                            Command="{Binding MailTo}"
                            CommandParameter="support@gamespur.games"/>

                    <Button Text="General: contact@gamespur.games"
                            BackgroundColor="{StaticResource LightDark}"
                            TextColor="{StaticResource FontColor}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            CornerRadius="15"
                            Padding="10,0"
                            HeightRequest="30"
                            FontFamily="P-Bold"
                            Command="{Binding MailTo}"
                            CommandParameter="contact@gamespur.games"
                            Grid.Row="1"/>
                </Grid>

            <!-- Creator -->
            <Label Text="Founders"
                   Grid.Row="11"
                   Style="{StaticResource TitleStyle}" 
                   />

            <BoxView Grid.Row="12"
                     Style="{StaticResource SeparatorStyle}"/>
                <ScrollView Grid.Row="13"
                            Orientation="Horizontal">
                    <StackLayout Orientation="Horizontal"
                                 Spacing="5">
                    <!-- Card creator -->
                    <Border Grid.Row="13"
                            BackgroundColor="{StaticResource LightDark}"
                            StrokeShape="RoundRectangle 15"
                            WidthRequest="220"
                            HeightRequest="108"
                            Margin="0,20"
                            HorizontalOptions="Center"
                            Padding="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Profile pic -->
                            <mct:AvatarView Grid.Column="0" 
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 BackgroundColor="{DynamicResource Dark}"
                                 TextColor="{DynamicResource Dark}"
                                 Text=""
                                 StrokeThickness="0"
                                 HeightRequest="70"
                                 WidthRequest="70"
                                 ImageSource="https://avatars.githubusercontent.com/u/37577669?v=4" />

                            <Grid Grid.Column="1"
                                  Margin="0,20,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                </Grid.RowDefinitions>

                                <!-- Name -->
                                <Label Text="Brice Friha"
                                        FontSize="18"
                                        Grid.Row="0"
                                        FontFamily="P-Bold"
                                        TextColor="{StaticResource FontColor}"
                                        VerticalOptions="Center"/>

                                <!-- Twitter -->
                                <StackLayout Orientation="Horizontal"
                                              Grid.Row="1"
                                              Spacing="5">
                                    <!-- Twitter logo -->
                                    <Label Text="&#xe61a;"
                                            FontSize="15"
                                            FontFamily="FaBrand"
                                            TextColor="#e4e5e7"
                                            VerticalOptions="Center"/>

                                    <!-- Name -->
                                    <Label Text="@BriceFriha"
                                            FontSize="14"
                                            FontFamily="P-Bold"
                                            VerticalOptions="Center"
                                             x:Name="BriceTwitterBtn"
                                            TextColor="{StaticResource FontColor}">
                                        <Label.Behaviors>
                                            <mct:TouchBehavior CommandParameter="bricefriha"
                                            BindingContext="{Binding Source={x:Reference thy},Path=BindingContext, x:DataType=ContentPage}"
                                            Command="{Binding ViewTwitter}"/>
                                        </Label.Behaviors>
                                    </Label>
                                </StackLayout>
                            </Grid>

                        </Grid>
                    </Border>
                    <!-- Card creator -->
                    <Border Grid.Row="13"
                            BackgroundColor="{StaticResource LightDark}"
                            StrokeShape="RoundRectangle 15"
                            WidthRequest="220"
                            HeightRequest="108"
                            Margin="0,20"
                            HorizontalOptions="Center"
                            Padding="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Profile pic -->
                            <mct:AvatarView Grid.Column="0" 
                                             HorizontalOptions="Center"
                                             VerticalOptions="Center"
                                             BackgroundColor="{DynamicResource Dark}"
                                             TextColor="{DynamicResource Dark}"
                                             Text=""
                                             StrokeThickness="0"
                                             HeightRequest="70"
                                             WidthRequest="70"
                                             ImageSource="https://avatars.githubusercontent.com/u/122379473?v=4" />

                            <Grid Grid.Column="1"
                                    Margin="0,20,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                </Grid.RowDefinitions>

                                <!-- Name -->
                                <Label Text="Emma Boyle"
                                        FontSize="18"
                                        Grid.Row="0"
                                        FontFamily="P-Bold"
                                        TextColor="{StaticResource FontColor}"
                                            VerticalOptions="Center"/>
                            </Grid>

                        </Grid>
                    </Border>

                </StackLayout>
                </ScrollView>
                
            
           

            <!-- Partners -->
            <Label Text="Partners"
                   Grid.Row="14"
                   Style="{StaticResource TitleStyle}" 
                   />

            <BoxView Grid.Row="15"
                     Style="{StaticResource SeparatorStyle}"/>
                <StackLayout Grid.Row="16"
                             BindableLayout.ItemsSource="{Binding Partners}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:Partner">
                            <ImageButton Command="{Binding View}" 
                                         Source="{Binding Logo}"
                                         CommandParameter="{Binding Url}"
                                         WidthRequest="265"
                                         HeightRequest="108"
                                         CornerRadius="15"
                                         Margin="0,20"
                                         BackgroundColor="White"/>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
            </StackLayout>
            
            
                <Label Text="© 2026 GameSpur"
                       FontSize="12"
                       Grid.Row="17"
                       FontFamily="P-regular"
                       TextColor="{StaticResource FontColor}"
                       VerticalOptions="Center"
                       HorizontalOptions="Center"/>
            </Grid>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>